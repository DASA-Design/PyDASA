{
    "python.analysis.typeCheckingMode": "standard",
    "python.testing.pytestArgs": [
        "tests",
        "--cov=src/pydasa",
        "--cov-report=html",
        "--cov-report=term-missing",
        "-v"
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src"
    ],
    "python.envFile": "${workspaceFolder}/.env",
    "flake8.args": [
        // "--max-line-length=120", W503
        "--ignore=E501,",
    ],
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./tests",
        "-p",
        "test_*.py"
    ],
    "coverage-gutters.coverageFileNames": [
        ".coverage",
        "coverage.xml",
        "htmlcov/index.html"
    ],
    "codeStatsViewer.maxLargestFilesSidebar": 10,
    "ruff.enable": false,
    // Pylance: analysis only (does not hide anything in the Explorer)
    "python.analysis.exclude": [
    "**/.claude",
    "**/scratchpad",
    "**/outputs",
    "**/build",
    "**/dist",
    "**/*.egg-info",
    "**/htmlcov",
    "**/_build",
    "**/site-packages",
    "**/venv",
    "**/env",
    "**/.tox",
    "**/.nox",
    "**/*.ipynb_checkpoints"
    ],
    // Explorer and search: hide the same clutter from view
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.egg-info": true,
        "**/.claude/settings.local.json": true
    },
    "search.exclude": {
        "**/.claude": true,
        "**/scratchpad": true,
        "**/build": true,
        "**/dist": true,
        "**/htmlcov": true,
        "**/*.egg-info": true
    },
    "files.watcherExclude": {
        "**/.claude/**": true,
        "**/scratchpad/**": true,
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/node_modules/**": true
    }
}
